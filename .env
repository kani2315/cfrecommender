# ─────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────
# Option 1: SQLite (default — no Docker needed)
DATABASE_URL=sqlite:///./data/app.db

# Option 2: PostgreSQL (uncomment when running Docker)
# To start PostgreSQL:  docker compose -f docker-compose.db.yml up -d
# DATABASE_URL=postgresql://recommender:recommender123@localhost:5432/recommender_db
